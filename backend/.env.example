spring.application.name=hangout-backend
server.port=8080

spring.data.mongodb.uri=${MONGODB_URI:mongodb://localhost:27017/hangout_db}
spring.data.mongodb.database=hangout_db

spring.config.import=optional:file:.env[.properties]

app.seed-data.enabled=${APP_SEED_DATA_ENABLED:true}

jwt.secret=${JWT_SECRET:your-secret-key-change-in-production-must-be-at-least-256-bits}
jwt.expiration=86400000

cors.allowed-origins=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*

gemini.api-key=${GEMINI_API_KEY}
gemini.model=${GEMINI_MODEL:gemini-flash-lite-latest}


logging.level.com.hangout=DEBUG
logging.level.org.springframework.data.mongodb=DEBUG